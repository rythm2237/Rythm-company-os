# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional public contact shown on Enterprise / Assisted Build intake pages
NEXT_PUBLIC_SALES_EMAIL=sales@example.com

# Search engine ownership verification tokens. Values are intentionally rendered
# into public HTML meta tags and should contain only the verification token value.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Server-only credentials. Never expose these in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key
RESEND_WEBHOOK_SECRET=whsec_your-resend-webhook-signing-secret
RESEND_API_KEY=re_your-resend-api-key
CLOUDFLARE_EMAIL_INGEST_SECRET=replace-with-a-long-random-secret
STRIPE_SECRET_KEY=sk_live_or_test_server_only
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_endpoint_secret

# Runtime controls
RYTHM_ENV=development
RYTHM_AGENT_EXECUTION_ENABLED=false
RYTHM_EXTERNAL_ACTIONS_ENABLED=false
RYTHM_MONTHLY_AI_BUDGET_USD=25
RYTHM_AGENT_TIMEOUT_MS=45000
RYTHM_AGENT_MAX_RETRIES=1

# RYTHM adaptive model registry.
# Concrete model IDs live here, never in Agent/UI code. Provider defaults to openai.
# Pricing stays environment/config driven because provider pricing may change.
RYTHM_MODEL_LUNA=gpt-5.6-luna
RYTHM_MODEL_LUNA_PROVIDER=openai
RYTHM_MODEL_LUNA_REASONING=low,medium
RYTHM_MODEL_LUNA_INPUT_COST_PER_MILLION_USD=
RYTHM_MODEL_LUNA_OUTPUT_COST_PER_MILLION_USD=

RYTHM_MODEL_TERRA=gpt-5.6-terra
RYTHM_MODEL_TERRA_PROVIDER=openai
RYTHM_MODEL_TERRA_REASONING=low,medium,high
RYTHM_MODEL_TERRA_INPUT_COST_PER_MILLION_USD=
RYTHM_MODEL_TERRA_OUTPUT_COST_PER_MILLION_USD=

RYTHM_MODEL_SOL=gpt-5.6-sol
RYTHM_MODEL_SOL_PROVIDER=openai
RYTHM_MODEL_SOL_REASONING=medium,high
RYTHM_MODEL_SOL_INPUT_COST_PER_MILLION_USD=
RYTHM_MODEL_SOL_OUTPUT_COST_PER_MILLION_USD=

# Legacy compatibility/fallback only.
RYTHM_OPENAI_AGENT_MODEL=
RYTHM_ANTHROPIC_AGENT_MODEL=
RYTHM_GEMINI_AGENT_MODEL=
RYTHM_DRY_RUN_MODEL=
